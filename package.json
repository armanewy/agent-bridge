{
  "name": "agentbridge",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "ui:test": "playwright test",
    "ui:test:headed": "playwright test --headed",
    "ui:screenshots": "playwright test tests/ui/desktop-renderer-screenshots.spec.ts",
    "dev:local": "powershell -ExecutionPolicy Bypass -File scripts/dev-local.ps1",
    "dev:desktop": "pnpm --filter @agentbridge/desktop dev",
    "desktop:dev": "powershell -ExecutionPolicy Bypass -File scripts/dev-desktop-electron.ps1",
    "verify": "pnpm test && pnpm build && pnpm lint && git diff --check",
    "desktop:build": "pnpm --filter @agentbridge/desktop build",
    "desktop:package": "powershell -ExecutionPolicy Bypass -File scripts/package-desktop-windows.ps1 -Target dir",
    "desktop:dist": "powershell -ExecutionPolicy Bypass -File scripts/package-desktop-windows.ps1 -Target nsis",
    "desktop:package:win": "powershell -ExecutionPolicy Bypass -File scripts/package-desktop-windows.ps1 -Target dir",
    "desktop:dist:win": "powershell -ExecutionPolicy Bypass -File scripts/package-desktop-windows.ps1 -Target nsis",
    "desktop:package:mac": "pnpm --filter @agentbridge/native-host bundle && pnpm --filter @agentbridge/desktop build && pnpm --filter @agentbridge/desktop exec electron-builder --mac --dir --config electron-builder.yml",
    "desktop:dist:mac": "pnpm --filter @agentbridge/native-host bundle && pnpm --filter @agentbridge/desktop build && pnpm --filter @agentbridge/desktop exec electron-builder --mac dmg zip --config electron-builder.yml",
    "dev:extension": "pnpm --filter @agentbridge/extension dev",
    "dev:native-host": "pnpm --filter @agentbridge/native-host dev",
    "dev:win-uia-helper": "dotnet run --project apps/win-uia-helper/AgentBridge.WinUiaHelper.csproj",
    "build:win-uia-helper": "dotnet build apps/win-uia-helper/AgentBridge.WinUiaHelper.csproj",
    "test:win-uia-helper": "dotnet test apps/win-uia-helper/tests/AgentBridge.WinUiaHelper.Tests.csproj",
    "register:native-host": "powershell -ExecutionPolicy Bypass -File scripts/register-native-host-windows.ps1",
    "unregister:native-host": "powershell -ExecutionPolicy Bypass -File scripts/unregister-native-host-windows.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
