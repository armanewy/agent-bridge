{
  "name": "@agentbridge/native-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentbridge-native-host": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist-bundle/native-host.mjs",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@agentbridge/core": "workspace:*",
    "@agentbridge/local-store": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2"
  }
}
