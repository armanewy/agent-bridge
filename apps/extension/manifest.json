{
  "manifest_version": 3,
  "name": "AgentBridge",
  "version": "0.1.0",
  "description": "Explicitly capture selected browser text for local AgentBridge Task Cards.",
  "permissions": ["activeTab", "scripting", "nativeMessaging"],
  "background": {
    "service_worker": "dist/src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "AgentBridge",
    "default_popup": "popup.html"
  },
  "commands": {
    "capture-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Capture selected text into AgentBridge"
    }
  }
}
