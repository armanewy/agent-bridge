# Copy this file to .env.local or set these values in your shell.
# .env.local is gitignored and is loaded by `pnpm dev:local`.

# Hosted planner cloud key. Keep this server-side; the desktop app does not receive it.
OPENAI_API_KEY=

# Optional hosted planner model override.
AGENTBRIDGE_CLOUD_OPENAI_MODEL=gpt-4.1-mini

# Set to 1 to force deterministic local planner responses without OpenAI.
# AGENTBRIDGE_CLOUD_MOCK=1
